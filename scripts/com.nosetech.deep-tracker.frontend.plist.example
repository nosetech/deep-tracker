<?xml version="1.0" encoding="UTF-8"?>
<!-- frontend を常駐サービスとして launchd の per-user LaunchAgent に登録するためのテンプレート。
     ログイン時に起動し、終了したら再起動する（RunAtLoad / KeepAlive）。

     通常は scripts/service.sh install がこのファイルから plist を生成・登録する
     （__INSTANCE__ / __DEPLOY_ROOT__ / __PATH__ などの置換と、LAN_IP / TAILSCALE_IP の
     EnvironmentVariables への追加も行う）。手順は docs/setup.md を参照。

     Label に instance（設定ファイルの instance）を含めるため、
     instance の異なる展開先を別サービスとして並行登録できる。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nosetech.deep-tracker.__INSTANCE__.frontend</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$@" &gt; &gt;(cd "__DEPLOY_ROOT__/backend" &amp;&amp; exec "__DEPLOY_ROOT__/backend/.venv/bin/python" -m deep_tracker.log_rotator --path "__DEPLOY_ROOT__/logs/frontend.log") 2&gt;&amp;1</string>
        <string>deep-tracker-frontend</string>
        <string>__NODE__</string>
        <string>__DEPLOY_ROOT__/frontend/node_modules/next/dist/bin/next</string>
        <string>start</string>
        <string>-H</string>
        <string>__FRONTEND_HOST__</string>
        <string>-p</string>
        <string>__FRONTEND_PORT__</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__DEPLOY_ROOT__/frontend</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>BACKEND_URL</key>
        <string>__BACKEND_URL__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- 終了したら再起動する。クラッシュの連続による再起動ループを避けるため、10秒以上空ける -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <!-- 標準出力・標準エラーは deep_tracker.log_rotator へパイプし、JST 0時に日次ローテーションする
         （保持日数は config.yaml の logging.retention_days）。StandardOutPath へ直接出すとローテーション
         されず肥大化するため使わない。bash が本体へ exec するので、launchd が追跡・停止するのは本体のPID。
         本体が終了するとパイプが閉じ、ローテータも終了する。KeepAlive の再起動時は新しいローテータが起動する。 -->
</dict>
</plist>
