{
  "name": "deep-tracker-frontend",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev -H ${FRONTEND_HOST:-127.0.0.1} -p ${FRONTEND_PORT:-3700}",
    "build": "next build",
    "start": "next start -H ${FRONTEND_HOST:-127.0.0.1} -p ${FRONTEND_PORT:-3700}",
    "lint": "eslint",
    "test": "node --test",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.2",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "5.9.3"
  }
}
